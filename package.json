{
  "name": "learning-bb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/prerender-diagrams.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/prerender-diagrams.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "pretypecheck": "node scripts/prerender-diagrams.mjs",
    "test": "vitest",
    "pretest": "node scripts/prerender-diagrams.mjs",
    "validate:leaf": "node scripts/validate-content-leaf.mjs src/content",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:sources": "node scripts/audit-source-links.mjs",
    "audit:links": "node scripts/audit-static-links.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check": "npm run typecheck && npm test -- --run && npm run validate:leaf && npm run audit:content && npm run audit:sources && npm run audit:links && npm run check:budgets"
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3",
    "dompurify": "3.4.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.1",
    "oxlint": "1.75.0",
    "typescript": "6.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
